# Copy to `.env` and fill in only what you use. `.env` is git-ignored.
# Every external service is optional; Prohori runs fully offline without them.
# Environment variables take precedence over this file. See docs/ENRICHMENT.md.

# --- Enrichment (free tiers, non-commercial use; see docs/LICENSES.md)
# AbuseIPDB API key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=
# VirusTotal API key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=
# Local MaxMind GeoLite2 databases, downloaded with MaxMind's geoipupdate tool.
# Needs `pip install "prohori[geoip]"`. Example: C:/GeoIP/GeoLite2-City.mmdb
GEOLITE2_CITY_DB=
GEOLITE2_ASN_DB=

# Optional limits and cache (defaults shown)
PROHORI_CACHE_PATH=
PROHORI_CACHE_TTL_HOURS=24
ABUSEIPDB_DAILY_LIMIT=1000
VIRUSTOTAL_DAILY_LIMIT=500
VIRUSTOTAL_PER_MINUTE=4
PROHORI_HTTP_TIMEOUT=10

# --- LLM analyst (opt-in, off by default)
# Provider: none | mock | gemini
PROHORI_LLM_PROVIDER=none
GEMINI_API_KEY=
