    {
      "type": "timeseries",
      "title": "Rows stored per minute",
      "description": "Rows the sink wrote per minute and table, by when they were stored.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(stored_at, '1m'), 'events' AS metric, count(*) AS value\nFROM raw.events WHERE $__timeFilter(stored_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroupAlias(stored_at, '1m'), 'alerts', count(*)\nFROM raw.alerts WHERE $__timeFilter(stored_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroupAlias(stored_at, '1m'), 'incidents', count(*)\nFROM raw.incidents WHERE $__timeFilter(stored_at) GROUP BY 1\nUNION ALL\nSELECT $__timeGroupAlias(stored_at, '1m'), 'dead letters', count(*)\nFROM raw.dead_letters WHERE $__timeFilter(stored_at) GROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "table",
      "title": "Tables",
      "description": "Rows in each warehouse table and when the last one was stored.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'events' AS \"Table\", count(*) AS \"Rows\", max(stored_at) AS \"Last stored\" FROM raw.events\nUNION ALL SELECT 'alerts', count(*), max(stored_at) FROM raw.alerts\nUNION ALL SELECT 'incidents', count(*), max(stored_at) FROM raw.incidents\nUNION ALL SELECT 'dead_letters', count(*), max(stored_at) FROM raw.dead_letters\nUNION ALL SELECT 'labels', count(*), max(stored_at) FROM raw.labels\nUNION ALL SELECT 'model_evaluations', count(*), max(stored_at) FROM raw.model_evaluations"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 70,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 12
      }
    },
    {
      "type": "table",
      "title": "Dead letters by stage and reason",
      "description": "Grouped dead letters; the payloads are in raw.dead_letters.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT stage AS \"Stage\",\n       topic AS \"Topic\",\n       reason AS \"Reason\",\n       count(*) AS \"Messages\",\n       max(stored_at) AS \"Last\"\nFROM raw.dead_letters\nGROUP BY 1, 2, 3\nORDER BY 4 DESC, 5 DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 70,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
