  ],
  "panels": [
    {
      "type": "stat",
      "title": "Since the last stored event",
      "description": "Wall-clock time since the sink last stored an event. Grows while nothing is published.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - max(stored_at)) AS \"Since last event\" FROM raw.events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Events stored",
      "description": "Events stored in the time range (by when they were stored, not by event time).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Events stored\" FROM raw.events WHERE $__timeFilter(stored_at)"
