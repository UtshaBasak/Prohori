{
  "uid": "prohori-pipeline-health",
  "title": "Prohori - Pipeline health",
  "description": "Is the pipeline storing rows, how fast, and what it rejected. Times are when rows were stored.",
  "tags": [
    "prohori",
    "pipeline"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
