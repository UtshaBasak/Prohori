          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(first_seen, '1h'), severity AS metric, count(*) AS value\nFROM raw.incidents\nWHERE $__timeFilter(first_seen)\nGROUP BY 1, 2\nORDER BY 1"
