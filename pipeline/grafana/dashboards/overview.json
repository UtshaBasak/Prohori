    {
      "type": "bargauge",
      "title": "Rule hits",
      "description": "Alerts per rule or detector in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
