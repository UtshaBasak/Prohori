    {
      "type": "table",
      "title": "Incidents",
      "description": "The latest incidents in the time range. Open one with: prohori incidents (lite mode) or the warehouse's raw.incidents.record.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT first_seen AS \"First seen\",\n       last_seen AS \"Last seen\",\n       severity AS \"Severity\",\n       confidence AS \"Confidence\",\n       round(score::numeric, 1) AS \"Score\",\n       alert_count AS \"Alerts\",\n       title AS \"Title\"\nFROM raw.incidents\nWHERE $__timeFilter(first_seen)\nORDER BY first_seen DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 70,
            "cellOptions": {
              "type": "auto"
            }
          }
