            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT detector_id AS \"Rule\", count(*) AS \"Alerts\"\nFROM raw.alerts\nWHERE $__timeFilter(last_seen)\nGROUP BY 1\nORDER BY 2 DESC, 1\nLIMIT 20"
        }
      ],
      "fieldConfig": {
