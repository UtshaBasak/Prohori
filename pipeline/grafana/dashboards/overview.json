    {
      "type": "table",
      "title": "Top source addresses",
      "description": "Source addresses with the most failed events in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source_ip AS \"Source\",\n       count(*) AS \"Events\",\n       count(*) FILTER (WHERE outcome = 'failure') AS \"Failures\",\n       count(DISTINCT user_name) AS \"Accounts\",\n       min(\"timestamp\") AS \"First seen\",\n       max(\"timestamp\") AS \"Last seen\"\nFROM raw.events\nWHERE $__timeFilter(\"timestamp\") AND source_ip IS NOT NULL\nGROUP BY 1\nORDER BY 3 DESC, 2 DESC, 1\nLIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 70,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 10,
      "gridPos": {
        "h": 10,
        "w": 15,
        "x": 9,
        "y": 19
