{
  "uid": "prohori-detection-quality",
  "title": "Prohori - Detection quality",
  "description": "Rule precision, time to detect, detection latency and flow-model performance from the dbt marts.",
  "tags": [
    "prohori",
    "dbt"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
