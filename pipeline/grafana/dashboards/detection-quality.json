  "panels": [
    {
      "type": "text",
      "title": "About this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Built from the dbt marts (`marts.*`), not from the raw tables. They exist after a dbt build on the\nstack's database, and rule precision and attack detection need the simulator's labels:\n\n```\nprohori pipeline load-labels LOG --postgres postgresql://prohori:prohori@127.0.0.1:15432/prohori\nuv run dbt build --project-dir pipeline/dbt --profiles-dir pipeline/dbt --target postgres\n```\n\nFlow-model rows come from `prohori pipeline load-results results/ml_*.json`. See docs/WAREHOUSE.md."
      },
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Rule precision",
      "description": "Per rule: alerts, how many could be judged against the simulator's labels, and the share that were attacks (marts.rule_precision). Empty precision: no labelled alerts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT detector_id AS \"Rule\",\n       alerts AS \"Alerts\",\n       judged_alerts AS \"Judged\",\n       true_positives AS \"True positives\",\n       false_positives AS \"False positives\",\n       precision AS \"Precision\"\nFROM marts.rule_precision\nORDER BY alerts DESC, detector_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 70,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Precision"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-RdYlGr"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 2,
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Attack detection",
      "description": "Each simulated attack: whether a rule caught it and how long after it started (marts.attack_detection).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT scenario AS \"Scenario\",\n       attack_id AS \"Attack\",\n       started_at AS \"Started\",\n       detected AS \"Detected\",\n       time_to_detect_seconds AS \"Time to detect\",\n       alerts AS \"Alerts\",\n       rules AS \"Rules\"\nFROM marts.attack_detection\nORDER BY started_at, attack_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 70,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time to detect"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 3,
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Detection latency",
      "description": "Per rule: how long the activity ran before the rule fired (log time) and how long the pipeline took to store the alert (wall-clock time) (marts.detection_latency).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT detector_id AS \"Rule\",\n       alerts AS \"Alerts\",\n       median_activity_seconds AS \"Median activity\",\n       max_activity_seconds AS \"Max activity\",\n       median_pipeline_seconds AS \"Median pipeline\",\n       max_pipeline_seconds AS \"Max pipeline\"\nFROM marts.detection_latency\nORDER BY alerts DESC, detector_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 70,
            "cellOptions": {
