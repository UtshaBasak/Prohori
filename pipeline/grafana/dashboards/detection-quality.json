    {
      "type": "table",
      "title": "Flow models: latest evaluation",
      "description": "The latest evaluation of each flow model and operating point, averaged over seeds, with the change in recall since the evaluation before (marts.model_performance).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (dataset, variant, model, operating_point)\n       evaluated_at AS \"Evaluated\",\n       dataset AS \"Dataset\",\n       variant AS \"Variant\",\n       model AS \"Model\",\n       operating_point AS \"Operating point\",\n       recall AS \"Recall\",\n       precision AS \"Precision\",\n       false_alerts_per_10k AS \"False alerts per 10k\",\n       pr_auc AS \"PR AUC\",\n       recall_change AS \"Recall change\"\nFROM marts.model_performance\nORDER BY dataset, variant, model, operating_point, evaluated_at DESC"
        }
