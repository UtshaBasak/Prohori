    {
      "type": "table",
      "title": "Top source addresses",
      "description": "All-time ranking by alerts, then events (marts.top_source_ips).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
