    {
      "type": "timeseries",
      "title": "Flow-model recall over time",
      "description": "Recall per model and operating point at each evaluation in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "prohori-warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "prohori-warehouse"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT evaluated_at AS time, model || ' ' || operating_point || ' (' || variant || ')' AS metric, recall AS value\nFROM marts.model_performance\nWHERE $__timeFilter(evaluated_at)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
