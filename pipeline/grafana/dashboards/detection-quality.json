          "rawSql": "SELECT day AS \"Day\",\n       events AS \"Events\",\n       failed_events AS \"Failures\",\n       source_ips AS \"Sources\",\n       alerts AS \"Alerts\",\n       high_alerts AS \"High alerts\",\n       rules_fired AS \"Rules fired\",\n       incidents AS \"Incidents\"\nFROM marts.daily_attack_counts\nWHERE $__timeFilter(day)\nORDER BY day DESC"
