          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rank AS \"Rank\",\n       source_ip AS \"Source\",\n       events AS \"Events\",\n       failed_events AS \"Failures\",\n       accounts AS \"Accounts\",\n       alerts AS \"Alerts\",\n       incidents AS \"Incidents\"\nFROM marts.top_source_ips\nORDER BY rank\nLIMIT 15"
